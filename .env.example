PORT=4000
NODE_ENV=development

# PostgreSQL brukes fortsatt av deler av avviksmodulen.
DATABASE_URL=postgres://user:password@localhost:5432/governance

# MongoDB brukes for auth, brukere, firma og avdelinger.
# Lim inn hele tilkoblingsstrengen fra MongoDB Atlas her.
MONGO_URL=SETT_INN_MONGO_URL_HER
UPLOAD_DIR=./uploads

# Bytt denne i alle miljøer utenom ren lokal testing.
JWT_SECRET=bytt-denne-til-en-lang-hemmelig-nokkel
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Kommaseparert liste ved behov.
ALLOW_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE=http://localhost:4000/api/v1
VITE_DEV_USER_ID=

# Seed-script for første adminbruker
SEED_COMPANY_NAME=TQM Demo
SEED_COMPANY_SLUG=tqm-demo
SEED_DEPARTMENT_NAME=Administrasjon
SEED_DEPARTMENT_CODE=ADM
SEED_ADMIN_FIRST_NAME=Kristian
SEED_ADMIN_LAST_NAME=Henriksen
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=sett-et-midlertidig-passord
SEED_ADMIN_ROLE=superadmin
SEED_ADMIN_JOB_TITLE=Systemadministrator
